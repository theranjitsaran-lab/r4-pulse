# Postgres — DigitalOcean managed database. Rotate the password if it has ever been in a chat.
DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Session cookie secret — 32 random characters. Regenerate if it has ever been in a chat.
SESSION_SECRET=change-me

# Users: name:bcryptHash:role, comma separated. Roles: owner, ops, billing, admin.
# Make a hash with:  node -e "console.log(require('bcryptjs').hashSync('the password', 10))"
AUTH_USERS=theran:$2a$10$replace-with-a-real-hash:admin

# 1 = read fixtures/*.json instead of the database (design work, offline)
USE_FIXTURES=1
PORT=3000
